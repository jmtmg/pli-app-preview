# -----------------------------------------------------------------------------
# PLI local-v1 — exemple secret-safe.
# Copier/générer en .env.local uniquement. .env.local est gitignoré.
# Recommandé : `make local-v1-env`, qui génère une vraie PLI_SECRET_KEY et
# prépare des chemins absolus sous .pli-local-v1/ sans imprimer de secret.
# -----------------------------------------------------------------------------

PLI_MODE=local
PLI_DEBUG=false
PLI_DEMO=false
PLI_SECRET_KEY=GENERATE_WITH_make_local-v1-env

PLI_BASE_URL=http://localhost:8000
PLI_APP_URL=http://localhost:5173
PLI_CORS_ORIGINS='["http://localhost:5173"]'

# Remplacer par des chemins absolus locaux, ou laisser le générateur les écrire.
PLI_DB_PATH=/ABSOLUTE/PATH/TO/pli-app/.pli-local-v1/db.sqlite
PLI_ATTACHMENTS_DIR=/ABSOLUTE/PATH/TO/pli-app/.pli-local-v1/attachments

# Optionnel mais recommandé avant stockage d'emails réels si SQLCipher est installé.
PLI_SQLCIPHER_KEY=

# local-v1 ne requiert pas d'OAuth réel par défaut.
PLI_GMAIL_CLIENT_ID=
PLI_GMAIL_CLIENT_SECRET=
PLI_GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
PLI_MS_CLIENT_ID=
PLI_MS_CLIENT_SECRET=
PLI_MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
PLI_MS_TENANT_ID=common
