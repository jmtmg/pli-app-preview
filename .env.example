# -----------------------------------------------------------------------------
# PLI — exemple de configuration.
# Copier en .env. .env est gitignoré — ne JAMAIS le commit.
# -----------------------------------------------------------------------------

# === Mode ===
# local  → SQLite + SQLCipher, 1 utilisateur (machine = tenant)
# cloud  → PostgreSQL multi-tenant + JWT + Stripe
PLI_MODE=local
PLI_DEBUG=true
# Données de démonstration locales sans credentials OAuth réels.
PLI_DEMO=true
# openssl rand -base64 64
PLI_SECRET_KEY=change-me-64chars

# === DB local ===
PLI_DB_PATH=~/.pli/db.sqlite
PLI_ATTACHMENTS_DIR=~/.pli/att
# openssl rand -hex 32 (optionnel mais recommandé)
PLI_SQLCIPHER_KEY=

# === DB cloud ===
PLI_DATABASE_URL=postgresql://pli:pli@localhost:5432/pli
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLI_CLOUD_CRYPTO_KEY=

# === Stockage objet S3-compatible (cloud) ===
PLI_S3_ENDPOINT_URL=http://localhost:9000
PLI_S3_ACCESS_KEY=minioadmin
PLI_S3_SECRET_KEY=minioadmin
PLI_S3_BUCKET=pli-staging-attachments
PLI_S3_REGION=eu-west-3

# === URLs publiques ===
PLI_BASE_URL=http://localhost:8000
PLI_APP_URL=http://localhost:5173
PLI_CORS_ORIGINS='["http://localhost:5173"]'

# === OAuth Gmail ===
# Console : https://console.cloud.google.com/apis/credentials
# Runbook complet : docs/runbooks/oauth-gmail-setup.md
# IMPORTANT : variables = PLI_GMAIL_* (pas PLI_GOOGLE_*) — alignement
# avec le slug provider utilise par le schema SQL (`gmail`, pas `google`).
PLI_GMAIL_CLIENT_ID=
PLI_GMAIL_CLIENT_SECRET=
PLI_GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# === OAuth Microsoft ===
# Portail : https://portal.azure.com → App registrations
PLI_MS_CLIENT_ID=
PLI_MS_CLIENT_SECRET=
PLI_MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
PLI_MS_TENANT_ID=common

# === Stripe (cloud uniquement) ===
PLI_STRIPE_SECRET_KEY=sk_test_...
# Obtenu via : stripe listen
PLI_STRIPE_WEBHOOK_SECRET=whsec_...
PLI_STRIPE_PRICE_MONTHLY=price_...
PLI_STRIPE_PRICE_YEARLY=price_...
PLI_STRIPE_TRIAL_DAYS=14

# === Emails transactionnels ===
# memory   → écrit dans une liste in-process (dev/tests)
# smtp     → serveur SMTP (dev via MailHog)
# sendgrid / postmark → API HTTP
PLI_EMAIL_PROVIDER=memory
PLI_EMAIL_API_KEY=
PLI_EMAIL_FROM=noreply@pli.app
PLI_EMAIL_SMTP_HOST=localhost
PLI_EMAIL_SMTP_PORT=1025

# === Licences PLI Plus (Local) ===
# Génération : python scripts/generate_license_keypair.py
PLI_LICENSE_SIGNING_KEY=

# === Telemetry ===
PLI_SENTRY_DSN=

# === Sync ===
PLI_INITIAL_SYNC_DAYS=30
PLI_INCREMENTAL_SYNC_INTERVAL_S=60
PLI_SYNC_MAX_RETRIES=4
