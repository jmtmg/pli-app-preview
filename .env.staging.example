# -----------------------------------------------------------------------------
# PLI — template cloud-staging secret-safe.
# Copier en .env.staging, chmod 600, puis renseigner UNIQUEMENT via un
# gestionnaire de secrets / console provider officielle. Ne jamais commiter
# .env.staging et ne jamais coller les valeurs dans un ticket ou une sortie CI.
# -----------------------------------------------------------------------------

# === Mode exposé staging ===
PLI_MODE=cloud
PLI_DEBUG=false
PLI_DEMO=false
PLI_ENABLE_M2=false

# === URLs publiques staging ===
# Le fly.toml actuel expose le backend sur https://staging.pli.app.
# Si le frontend est hébergé sur un autre domaine, remplacer PLI_APP_URL et
# PLI_CORS_ORIGINS par l'origine HTTPS exacte du frontend.
# PLI_CORS_ORIGINS doit rester une JSON list encodée en string.
PLI_BASE_URL=https://staging.pli.app
PLI_APP_URL=https://staging.pli.app
PLI_CORS_ORIGINS='["https://staging.pli.app"]'

# Frontend build-time (Vite). Garder cohérent avec PLI_BASE_URL.
VITE_API_URL=https://staging.pli.app
VITE_PLI_MODE=cloud

# === Secrets applicatifs — valeurs réelles dans secret manager uniquement ===
# Générer une valeur longue dans le gestionnaire de secrets ou une console privée,
# puis la stocker sans l'imprimer en CI/chat.
PLI_SECRET_KEY=
# Générer une clé Fernet cloud de la même manière, hors historique/logs.
PLI_CLOUD_CRYPTO_KEY=

# === PostgreSQL staging managé ===
# Exemples de fournisseurs à décider: Fly Postgres, Neon, Supabase, Scaleway.
# L'URL réelle contient un mot de passe et doit rester hors logs.
PLI_DATABASE_URL=

# === Stockage objet S3-compatible staging ===
# Exemples de fournisseurs à décider: Cloudflare R2, Scaleway Object Storage,
# AWS S3. Endpoint/access/secret réels via secret manager uniquement.
# Le bucket ci-dessous est un nom proposé : il doit être créé/provisionné avant GO.
PLI_S3_ENDPOINT_URL=
PLI_S3_ACCESS_KEY=
PLI_S3_SECRET_KEY=
PLI_S3_BUCKET=pli-staging-attachments
PLI_S3_REGION=eu-west-3

# === Email transactionnel staging ===
# Choisir exactement un provider: smtp | sendgrid | postmark.
# Tant que le provider est vide, le preflight cloud-staging doit rester bloqué.
PLI_EMAIL_PROVIDER=
PLI_EMAIL_API_KEY=
PLI_EMAIL_FROM=noreply@pli.app
PLI_EMAIL_SMTP_HOST=
PLI_EMAIL_SMTP_PORT=587
PLI_EMAIL_SMTP_USER=
PLI_EMAIL_SMTP_PASSWORD=

# === OAuth Gmail staging ===
# Créer une app OAuth officielle staging et déclarer exactement ce redirect.
PLI_GMAIL_CLIENT_ID=
PLI_GMAIL_CLIENT_SECRET=
PLI_GMAIL_REDIRECT_URI=https://staging.pli.app/auth/gmail/callback

# === OAuth Microsoft staging ===
# Créer une App Registration staging et déclarer exactement ce redirect.
PLI_MS_CLIENT_ID=
PLI_MS_CLIENT_SECRET=
PLI_MS_REDIRECT_URI=https://staging.pli.app/auth/microsoft/callback
PLI_MS_TENANT_ID=common

# === Billing/Stripe — désactivé tant que M2/cloud billing n'est pas validé ===
PLI_STRIPE_SECRET_KEY=
PLI_STRIPE_WEBHOOK_SECRET=
PLI_STRIPE_PRICE_MONTHLY=
PLI_STRIPE_PRICE_YEARLY=
PLI_STRIPE_TRIAL_DAYS=14

# === Observabilité optionnelle staging ===
PLI_SENTRY_DSN=
PLI_INITIAL_SYNC_DAYS=30
PLI_INCREMENTAL_SYNC_INTERVAL_S=60
PLI_SYNC_MAX_RETRIES=4
